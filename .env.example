# Admin Credentials (Server-side)
ADMIN_PASSWORD=

# Meta API Configuration
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CONFIG_ID=

# JWT Secret (Server-side only)
JWT_SECRET=

# Database URL (PostgreSQL)
DATABASE_URL=

# AI Studio (Gemini API Key)
GEMINI_API_KEY=

# Application URL
APP_URL=
ADMIN_SECRET=

# Webhook Secrets
WEBHOOK_SECRET=

# Legacy MCP connection hardening (server-side only)
# Required for POST /mcp, POST /api/mcp, SSE, and SSE messages.
MCP_API_KEY=

# Keep false during the Page Center V2 migration. Enabling this restores
# publish_page_post and toggle_hide_comment on the legacy MCP endpoint.
MCP_LEGACY_WRITES_ENABLED=false

# Page Center V2 staged rollout (server-side only)
# Keep disabled until a preview environment is ready for the B cohort.
PAGE_CENTER_V2_ENABLED=false

# Comma-separated user IDs or emails. Optional explicit prefixes are supported:
# id:123,email:user@example.com. Wildcards and roles do not grant access.
PAGE_CENTER_V2_ALLOWLIST=

# MCP OAuth 2.1 (server-side only)
# Set this to the stable public origin, without a trailing slash.
# Vercel previews fall back to the deployment's VERCEL_URL automatically.
MCP_OAUTH_ISSUER=

# Comma-separated HTTPS origins allowed to supply Client ID Metadata Documents.
MCP_OAUTH_CLIENT_METADATA_ORIGINS=https://chatgpt.com

# Page Center V2 Meta OAuth (server-side only)
# Generate exactly 32 random bytes, encoded as 64 hex chars or standard base64.
# Never prefix this variable with NEXT_PUBLIC_ and never commit a real value.
PAGE_CENTER_TOKEN_ENCRYPTION_KEY=

# Full callback URI registered in the Meta app. If blank, APP_URL is used with
# /api/page-center-v2/meta/callback. Use a separate value per Vercel environment.
PAGE_CENTER_META_REDIRECT_URI=

# Required for Page Center. Set this to a currently supported version selected
# in the Meta app dashboard; there is intentionally no silent fallback.
META_GRAPH_API_VERSION=

# Admin Credentials (Server-side)
ADMIN_PASSWORD=

# Meta API Configuration
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CONFIG_ID=

# JWT Secret (Server-side only)
JWT_SECRET=

# Database URL (PostgreSQL)
DATABASE_URL=

# AI Studio (Gemini API Key)
GEMINI_API_KEY=

# Application URL
APP_URL=
ADMIN_SECRET=

# Webhook Secrets
WEBHOOK_SECRET=

# Legacy MCP connection hardening (server-side only)
# Required for POST /mcp, POST /api/mcp, SSE, and SSE messages.
MCP_API_KEY=

# Keep false during the Page Center V2 migration. Enabling this restores
# publish_page_post and toggle_hide_comment on the legacy MCP endpoint.
MCP_LEGACY_WRITES_ENABLED=false
